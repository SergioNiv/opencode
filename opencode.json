{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "doom_loop": "ask",
    "external_directory": {
      "*": "allow",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.docker/config.json": "deny",
      "~/.netrc": "deny"
    },
    "task": {
      "*": "allow",
      "critic": "deny"
    },
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm -r *": "deny",
      "sudo rm *": "deny",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "git push * --force*": "deny",
      "git push * -f *": "deny",
      "git reset --hard*": "deny",
      "git clean -f*": "deny",
      "git clean * -f*": "deny",
      "dd *": "deny",
      "mkfs*": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "poweroff*": "deny",
      "chown -R *": "deny",
      "chmod -R *": "deny",
      "* | sh*": "deny",
      "* | bash*": "deny"
    }
  },
  "plugin": [
    [
      "./plugin/actor-critic.ts",
      {
        "maxIterations": 3,
        "actorAgent": "actor-managed",
        "criticAgent": "critic",
        "inlineActorAgent": "actor-managed-inline",
        "maxDiffChars": 40000,
        "keepCriticSession": false
      }
    ]
  ],
  "provider": {
    "qwen-alibaba": {
      "name": "Qwen (Alibaba Model Studio)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://ws-ynqpf2qubkqf1vzl.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1",
        "apiKey": "{file:./.secrets/qwen-api-key}"
      },
      "models": {
        "qwen3.8-max-0902": {
          "name": "Qwen3.8 Max (thinking)",
          "reasoning": true,
          "options": { 
            "enable_thinking": true,
            "reasoningEffort": "high"
          },
          "limit": { "context": 1000000, "output": 128000 }
        }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "options": { 
        "baseURL": "https://api.deepseek.com",
        "apiKey": "{file:./.secrets/deepseek-api-key}"
      },
      "models": {
        "deepseek-flash": {
          "name": "deepseek-flash (multimodal)",
          "attachment": true,
          "modalities": { "input": ["text", "image"] },
          "reasoning": true,
          "options": { "reasoningEffort": "high" },
          "variants": {
            "max":  { "reasoningEffort": "max" },
            "high": { "reasoningEffort": "high" },
            "low":  { "reasoningEffort": "low" }
          },
          "limit": { "context": 1000000, "output": 384000 }
        }
      }
    },
    "llama-local": {
      "name": "vllm (PC)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.68.108:8000/v1",
        "apiKey": "{file:./.secrets/vllm-api-key}"
      },
      "models": {
        "qwen3.8": {
          "name": "Qwen3.8 27B (multimodal)",
          "attachment": true,
          "modalities": { "input": ["text", "image"] },
          "options": { "reasoningEffort": "medium" },
          "variants": {
            "max":    { "reasoningEffort": "xhigh" },
            "medium": { "reasoningEffort": "medium" },
            "low":    { "reasoningEffort": "low" }
          },
          "limit": { "context": 128000, "output": 8192 }
        },
        "qwen3-32b": {
          "name": "Qwen3 32B AWQ (solo texto)",
          "limit": { "context": 31000, "output": 8192 }
        }
      }
    },
    "llama-local-2": {
      "name": "llama.cpp (Mac mini)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://192.168.68.112:8080/v1"
      },
      "models": {
        "Qwen2.5-Coder-7B-Instruct-4bit": {
          "name": "Qwen2.5 Coder 7B (local)",
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "options": {
            "stop": ["<|im_end|>"],
            "max_tokens": 2048
          }
        },
        "Qwen2.5-7B-Instruct-4bit": {
          "name": "Qwen2.5 7B (local)",
          "limit": {
            "context": 16384,
            "output": 4096
          },
          "options": {
            "stop": ["<|im_end|>"],
            "max_tokens": 2048
          }
        }
      }
    }
  }
}